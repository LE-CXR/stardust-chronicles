  "cues": [
    {
      "act": "01 星尘",
      "text": "你身体里的碳，是从哪里来的？",
      "start": 0.0,
      "dur": 3.02
    },
    {
      "act": "01 星尘",
      "text": "一百三十七亿年前，宇宙里只有氢和氦。",
      "start": 3.52,
      "dur": 4.01
    },
    {
      "act": "01 星尘",
      "text": "引力把它们收成恒星。",
      "start": 8.03,
      "dur": 3.1
    },
    {
      "act": "02 熔炉",
      "text": "引力把氢压进核心，温度升到四千万度。",
      "start": 12.33,
      "dur": 4.06
    },
    {
      "act": "02 熔炉",
      "text": "氢核挤成氦，光从这里开始。",
      "start": 16.88,
      "dur": 4.06
    },
    {
      "act": "02 熔炉",
      "text": "燃料烧尽，核心收缩，一亿度，三个氦核撞成一个碳。",
      "start": 21.44,
      "dur": 5.88
    },
    {
      "act": "02 熔炉",
      "text": "碳再抓一个氦，就成了氧。",
      "start": 27.82,
      "dur": 3.05
    },
    {
      "act": "02 熔炉",
      "text": "大部分碳和氧，都在这一步造出来。",
      "start": 31.37,
      "dur": 3.84
    },
    {
      "act": "03 铁峰",
      "text": "碳、氧、硅，一层层往外烧，一直烧到铁。",
      "start": 36.41,
      "dur": 5.02
    },
    {
      "act": "03 铁峰",
      "text": "铁是终点。再往里挤，聚变不再放能，反而吸能。",
      "start": 41.92,
      "dur": 5.04
    },
    {
      "act": "03 铁峰",
      "text": "铁是恒星聚变还能净放能的最后一站。",
      "start": 47.46,
      "dur": 4.22
    },
    {
      "act": "04 爆发",
      "text": "恒星撑不住了，核心在不到一秒里塌缩。",
      "start": 52.89,
      "dur": 4.06
    },
    {
      "act": "04 爆发",
      "text": "爆发时，中子密集打进原子核。",
      "start": 57.44,
      "dur": 4.34
    },
    {
      "act": "04 爆发",
      "text": "金和铀，都是那一刻造出来的。",
      "start": 62.29,
      "dur": 3.07
    },
    {
      "act": "05 回望",
      "text": "碎片被抛进星际介质，混进下一团星云。",
      "start": 66.56,
      "dur": 3.74
    },
    {
      "act": "05 回望",
      "text": "四十六亿年前，这些原子凝成了太阳和地球。",
      "start": 70.8,
      "dur": 4.56
    },
    {
      "act": "05 回望",
      "text": "现在，你血液里的铁，骨骼里的钙，",
      "start": 75.86,
      "dur": 3.46
    },
    {
      "act": "05 回望",
      "text": "都来自已经死去的恒星。",
      "start": 79.82,
      "dur": 3.29
    },
    {
