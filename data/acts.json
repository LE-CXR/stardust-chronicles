{"total":110.79,"acts":[{"name":"01 星尘","start":0.0,"end":12.33},{"name":"02 熔炉","start":12.33,"end":36.41},{"name":"03 铁峰","start":36.41,"end":52.89},{"name":"04 爆发","start":52.89,"end":66.56},{"name":"05 回望","start":66.56,"end":89.37},{"name":"06 表格","start":89.37,"end":105.63},{"name":"07 邀请","start":105.63,"end":110.79}],"cues":[{"act":"01 星尘","text":"你身体里的碳，是从哪里来的？","start":0.0,"dur":3.02},{"act":"01 星尘","text":"一百三十七亿年前，宇宙里只有氢和氦。","start":3.52,"dur":4.01},{"act":"01 星尘","text":"它被引力拉成一颗颗恒星。","start":8.03,"dur":3.1},{"act":"02 熔炉","text":"引力把氢压进核心，温度升到四千万度。","start":12.33,"dur":4.06},{"act":"02 熔炉","text":"氢的原子核挤成氦，光就是这样被点亮。","start":16.88,"dur":4.06},{"act":"02 熔炉","text":"燃料烧尽，核心收缩，一亿度，三个氦核撞成一个碳。","start":21.44,"dur":5.88},{"act":"02 熔炉","text":"碳再抓一个氦，就成了氧。","start":27.82,"dur":3.05},{"act":"02 熔炉","text":"宇宙里所有的碳和氧，都诞生在这一步。","start":31.37,"dur":3.84},{"act":"03 铁峰","text":"碳、氧、硅，一层层往外烧，一直烧到铁。","start":36.41,"dur":5.02},{"act":"03 铁峰","text":"铁是终点：再往里挤，聚变不再放能，反而吸能。","start":41.92,"dur":5.04},{"act":"03 铁峰","text":"所以铁，是恒星能给我们的最后一件礼物。","start":47.46,"dur":4.22},{"act":"04 爆发","text":"恒星撑不住了，核心在不到一秒里塌缩。","start":52.89,"dur":4.06},{"act":"04 爆发","text":"爆发的瞬间，中子像雨一样砸向原子核。","start":57.44,"dur":4.34},{"act":"04 爆发","text":"金和铀，都是那一刻造出来的。","start":62.29,"dur":3.07},{"act":"05 回望","text":"它们被抛进黑暗，混进下一代的星云。","start":66.56,"dur":3.74},{"act":"05 回望","text":"四十六亿年前，这些原子凝成了太阳和地球。","start":70.8,"dur":4.56},{"act":"05 回望","text":"现在，你血液里的铁，骨骼里的钙，","start":75.86,"dur":3.46},{"act":"05 回望","text":"都是那颗早已死去的恒星的遗物。","start":79.82,"dur":3.29},{"act":"05 回望","text":"你身体里每一个比铁更重的原子，都比地球更老。","start":83.61,"dur":4.56},{"act":"06 表格","text":"它们安静地排在周期表里面。","start":89.37,"dur":2.81},{"act":"06 表格","text":"氢的可见光，几乎是纯四度。","start":92.68,"dur":3.24},{"act":"06 表格","text":"钠燃烧的时候，只有一种最纯的亮黄。","start":96.42,"dur":3.82},{"act":"06 表格","text":"每个元素的光谱，都是它自己的指纹。","start":100.73,"dur":3.7},{"act":"07 邀请","text":"现在，轮到你自己，点开任何一个原子。","start":105.63,"dur":3.96}]}